      "frameId": null,
      "roundness": null,
      "seed": 1629264728,
      "version": 1,
      "versionNonce": 1849148525,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Design constraint, not an oversight:\n\nThe deposit tx always reveals an\naddress + amount \u2014 inherent to\nbridging a transparent asset in.\n\nFixed per-tier note sizes are what\nactually matter: if amounts were\nfree-form, an observer could match a\ndeposit to a later withdrawal just by\namount + rough timing, no address\nneeded. Same reasoning Tornado Cash's\nfixed denominations solve for.\n\nWhat's hidden is the LINK from this\ndeposit to whatever position or\nwithdrawal spends the note later \u2014\nnot the deposit event itself.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Design constraint, not an oversight:\n\nThe deposit tx always reveals an\naddress + amount \u2014 inherent to\nbridging a transparent asset in.\n\nFixed per-tier note sizes are what\nactually matter: if amounts were\nfree-form, an observer could match a\ndeposit to a later withdrawal just by\namount + rough timing, no address\nneeded. Same reasoning Tornado Cash's\nfixed denominations solve for.\n\nWhat's hidden is the LINK from this\ndeposit to whatever position or\nwithdrawal spends the note later \u2014\nnot the deposit event itself.",
      "lineHeight": 1.25,
      "baseline": 11
    },
