# Copy to terraform.tfvars and fill in.

# cer-perp-tee (the original test project) is no longer active — the most
# recent real end-to-end attestation run (docs/gcp-attestation-test-report.md,
# 2026-08-04 update) used cerdic-504518. Confirm which project you actually
# want before applying; both names are real prior test runs, neither is a
# placeholder.
project_id = "cerdic-504518"
region     = "us-central1"
zone       = "us-central1-a"

# Must already exist with Private Google Access enabled, see infra/README.md.
subnetwork = "default"

# Leave create_vm=false until deploy.sh has pushed a real image; then either
# set container_image here and re-apply, or just let deploy.sh manage the
# instance directly after the first apply has created the surrounding infra.
create_vm       = false
container_image = ""
