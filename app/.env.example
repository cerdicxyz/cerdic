# Which chain Privy's embedded wallet targets, and where the matcher's
# own HTTP API lives — see src/wallet/privy.ts's module docs. `local`
# (the default, so leaving this unset is fine) points at a local anvil
# instance (crates/cerdic-tee-matcher/src/bin/local_dev.rs); set to `arc`
# to switch to Arc Testnet instead — one line, no code change.
VITE_ACTIVE_CHAIN=local
VITE_CHAIN_RPC_URL=http://127.0.0.1:8545
VITE_MATCHER_URL=http://localhost:8787

# The mock USDC ERC20 DeployLocal.s.sol mints on local anvil — read by
# useWalletBalances.ts for the wallet dropdown's balance display.
# Redeployed fresh every `local_dev up`, so this changes on every
# redeploy; copy it from that run's own `USDC (mock): 0x...` log line.
# Unset: the dropdown just shows ETH.
VITE_USDC_ADDRESS=

# Account.sol — real collateral custody (deposit/withdraw via
# transferFrom), deployed by the same DeployLocal.s.sol run as USDC above
# — see DepositModal.tsx's module doc. Redeployed on every `local_dev up`.
VITE_ACCOUNT_ADDRESS=

# Privy (@privy-io/react-auth), the one login method currently enabled
# in LoginModal.tsx — see src/wallet/privy.ts's module docs for why it's
# architecturally different from the other three (all blocked on
# confirmed Arc-specific ERC-4337 infrastructure gaps, see
# pimlicoWallet.ts's docs for the full trail) and genuinely worth
# testing, not guaranteed to work.
#
# Get both from https://dashboard.privy.io — App settings for appId,
# Client settings for clientId (a real Privy app needs both, per their
# own React setup docs).
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=

# Pimlico ERC-4337 bundler/paymaster on Arc Testnet, backs the (currently
# disabled, see LoginModal.tsx) Wallet/Google/Passkey paths — see
# src/wallet/pimlicoWallet.ts's module docs for why (Circle's own Modular
# Wallets, VITE_CLIENT_KEY/VITE_CLIENT_URL below, is blocked on an
# unresolved account-side error on Circle's end, kept in the tree to swap
# back to).
#
# Get a key at https://dashboard.pimlico.io (Create API Key), enable
# bundler methods + verifying paymaster when prompted.
#
# SECURITY NOTE: Pimlico's own docs say this key belongs server-side, not
# in client code. This app has no backend to proxy it through yet, so
# this is a known, explicit, testnet-only shortcut, not an oversight —
# never do this with a mainnet key.
#
# Unset (the default in a fresh checkout): the wallet connect flow shows
# an honest "not configured" toast instead of a broken/fake connect
# button — see ConnectWallet.tsx.
VITE_PIMLICO_API_KEY=

# Circle Modular Wallets (ERC-4337 account abstraction), parked, not
# currently wired into wallet-context.tsx, see src/wallet/circleWallet.ts's
# module docs for the full picture and src/wallet/pimlicoWallet.ts's docs
# for why this isn't the active path right now.
#
# Both values come from https://console.circle.com — Wallets > Modular
# Wallets > your app's client key. This is a PUBLISHABLE client key, safe
# to ship in a browser bundle (unlike Circle's separate
# Developer-Controlled Wallets product, which needs a secret Bearer key
# and a server component this app doesn't have).
VITE_CLIENT_KEY=
VITE_CLIENT_URL=
